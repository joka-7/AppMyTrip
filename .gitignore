# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Locally-synthesized TTS audio (backend/services/tts.py: PiperTTSProvider)
backend/static/podcasts/*
!backend/static/podcasts/.gitkeep

# Local SQLite leftovers (if any; the app is Firestore-backed, not SQLite)
*.db

# Node / frontend
node_modules/
dist/
dist-ssr/
*.local

# Playwright (frontend/e2e)
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/playwright/.cache/

# Editors / OS
.idea/
.vscode/
.DS_Store

# Env
.env
.env.*
!.env.example
.coverage

# ai-sync generated skill trees. The rule files it also generates (AGENTS.md,
# CLAUDE.md, GEMINI.md, .github/copilot-instructions.md) ARE committed — CI and
# Vercel builds never initialize the .ai submodule, so those have to resolve
# without it. These directories are different: nothing in a build reads them,
# they are four identical copies of the same ~250KB, and `python .ai/bin/ai-sync`
# regenerates them on demand.
.claude/skills/
.claude/commands/
.agents/skills/
.cursor/skills/
.github/skills/
