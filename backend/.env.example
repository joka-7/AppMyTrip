# Copy to backend/.env and fill in. Loaded automatically via python-dotenv
# (see trip_api_backend.py) if present.

# --- LLM provider (powers /api/trip/parse and /api/trip/agent) ---
# Each user normally supplies their OWN key + provider choice from the
# frontend's "הגדרת מפתח API" navbar menu (sent per-request) — these env
# vars are only a fallback for local dev when no per-request key is sent.
# One of: gemini (default), openai, anthropic, groq, openrouter, cerebras, mistral
LLM_PROVIDER=gemini

# Used if LLM_PROVIDER=gemini. Free tier: https://ai.google.dev/
GEMINI_API_KEY=
# Optional, defaults to gemini-2.5-flash. Avoid dated preview snapshots
# (e.g. gemini-2.5-flash-preview-09-2025) — they get retired after a few months.
GEMINI_MODEL=

# Used if LLM_PROVIDER=openai. https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional, defaults to gpt-4o-mini
OPENAI_MODEL=

# Used if LLM_PROVIDER=anthropic. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional, defaults to claude-sonnet-4-5-20250929
ANTHROPIC_MODEL=

# Used if LLM_PROVIDER=groq. Free tier: https://console.groq.com/keys
GROQ_API_KEY=
# Optional, defaults to llama-3.3-70b-versatile
GROQ_MODEL=

# Used if LLM_PROVIDER=openrouter. Free models available: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional, defaults to a free model (deepseek/deepseek-chat-v3-0324:free).
# Free models come and go — override if the default is unavailable.
OPENROUTER_MODEL=

# Used if LLM_PROVIDER=cerebras. Free + very fast: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Optional, defaults to llama-3.3-70b
CEREBRAS_MODEL=

# Used if LLM_PROVIDER=mistral. Free tier: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# Optional, defaults to mistral-small-latest
MISTRAL_MODEL=

# --- Text-to-speech provider (powers /api/trip/generate-media) ---
# One of: mock (default, no cost/network), piper (real local TTS)
TTS_PROVIDER=mock
# Required if TTS_PROVIDER=piper — path to a downloaded Piper .onnx voice model
PIPER_VOICE_MODEL=

# --- CORS ---
# Comma-separated allowed origins; defaults to "*" if unset
CORS_ORIGINS=
