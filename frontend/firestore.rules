rules_version = '2';

// Trip storage rules for AppMyTrip (Firebase Spark/free plan).
// Paste this into Firebase console -> Firestore Database -> Rules
// (see README "Trip storage").
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can only read/write their own trips.
    match /users/{userId}/trips/{tripId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Publicly readable (no sign-in) once shared. Only the owner (by uid) can
    // create or unpublish a share. Once shared, the owner or anyone listed in
    // adminEmails (matched against the caller's verified sign-in email, so an
    // admin only needs to be invited by address, never looked up) can update
    // the trip's content in place and add further admins — that's what lets a
    // dedicated trip link be edited and re-shared by more than one person.
    match /sharedTrips/{tripId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.ownerId;
      allow update: if request.auth != null
        && request.resource.data.ownerId == resource.data.ownerId
        && (request.auth.uid == resource.data.ownerId
          || request.auth.token.email.lower() in resource.data.adminEmails);
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }
  }
}
