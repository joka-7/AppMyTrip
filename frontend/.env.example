# Base URL of the TripWeaver FastAPI backend.
# Copy to .env.local and adjust if your backend runs elsewhere.
VITE_API_URL=http://localhost:8000

# Firebase project config, used for Google sign-in and Firestore trip storage.
# See README.md "Trip storage".
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
