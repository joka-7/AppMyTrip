# Copy to .env.local and fill in. AI calls need no config: each user's own
# key goes from their device straight to their AI provider.

# OAuth *Web* client ID for Google sign-in and Drive (private trips are saved to
# each user's own Google Drive). Public by design. See README.md "Trip storage".
VITE_GOOGLE_CLIENT_ID=

# Firebase project config, used only for Firestore's encrypted shared trips.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
